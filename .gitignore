# 官方資料只存於本機或遠端運算環境，不隨程式上傳。
/dataset_A/
/dataset_B/

# 環境、快取、權重與執行產物。
.venv/
venv/
__pycache__/
*.py[cod]
.env
.env.*
.cache/
/checkpoints/
/reports/
# 前處理統計需隨最終模型交付；開發時先不自動加入 Git。
/audio_stats/
*.pt
*.pth
*.ckpt

# 保留產物資料夾結構，忽略實際訓練與預測產物。
/outputs/*/*
!/outputs/checkpoints/.gitkeep
!/outputs/logs/.gitkeep
!/outputs/predictions/.gitkeep
